# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=truck_oil_db
PG_USER=postgres
PG_PASSWORD=

# TruckMarket API
TRUCK_BASE_URL=
KEY_ID=
SECRET_KEY=
USER_ID=
COMPANY_ID=
GEO_CITY_ID_DEFAULT=

# OpenAI (опціонально — без ключа AI-описи вимикаються)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Web server
PORT=3000
HOST=0.0.0.0
# 32+ символів — для cookie-сесій. Згенерувати: openssl rand -base64 32
SESSION_SECRET=
# development | production. На prod ставте production:
#   - secure-cookie (потрібен HTTPS через reverse-proxy)
NODE_ENV=development

# --- Опціональні налаштування (мають безпечні дефолти в docker-compose) ---
# Часовий пояс (логи + UI). Дефолт Europe/Kyiv.
# TZ=Europe/Kyiv
# UI_TZ=Europe/Kyiv
# Порт publish БД на хост (dev/admin). На prod не публікуйте БД.
# PG_HOST_PORT=5434
# Розмір пулу з'єднань до БД.
# PG_POOL_MAX=10
# Ліміт розміру одного файла при завантаженні (байти). Дефолт 500 MB.
# MAX_UPLOAD_BYTES=524288000
# Скільки фонових задач можуть виконуватись одночасно.
# MAX_CONCURRENT_JOBS=3
