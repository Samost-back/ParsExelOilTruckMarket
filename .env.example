# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=truck_oil_db
PG_USER=postgres
PG_PASSWORD=

# TruckMarket API
TRUCK_BASE_URL=
KEY_ID=
SECRET_KEY=
USER_ID=
COMPANY_ID=
GEO_CITY_ID_DEFAULT=

# OpenAI (опціонально — без ключа AI-описи вимикаються)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Домен для HTTPS (Caddy отримає TLS-сертифікат Let's Encrypt на нього).
# Для AWS EC2 — публічний DNS-хост інстансу, напр.:
#   APP_DOMAIN=ec2-34-205-88-192.compute-1.amazonaws.com
# (на голий IP сертифікат не видається — потрібне доменне імʼя)
APP_DOMAIN=

# Web server
PORT=3000
HOST=0.0.0.0
# 32+ символів — для cookie-сесій. Згенерувати: openssl rand -base64 32
SESSION_SECRET=
# development | production. На prod ставте production:
#   - secure-cookie (cookie лише по HTTPS — потрібен reverse-proxy з TLS)
#   - trustProxy вмикається автоматично (див. TRUST_PROXY нижче)
NODE_ENV=development

# Довіра до reverse-proxy (X-Forwarded-Proto/For). ОБОВ'ЯЗКОВО за nginx/Caddy/
# Traefik з HTTPS-термінацією — інакше Fastify бачить http і secure-cookie не
# виставляться (вхід «не запам'ятовується»).
#   true   — довіряти будь-якому проксі (типово для одного фронт-проксі)
#   false  — вимкнути
#   <N>    — кількість проксі-хопів
#   <CIDR> — конкретні IP/підмережі через кому
# За замовчуванням: true коли NODE_ENV=production, інакше false.
# TRUST_PROXY=true

# --- Сховище файлів (фото/архіви) ---
# local — файлова система (dev, дефолт). s3 — AWS S3 / S3-сумісне (prod).
STORAGE_DRIVER=local
# Корінь локального сховища (для STORAGE_DRIVER=local). Дефолт ./photos_storage.
# STORAGE_ROOT=

# Для STORAGE_DRIVER=s3:
# S3_BUCKET=
# S3_REGION=eu-central-1
# Креди: лишіть порожніми, щоб узяти IAM-роль / стандартний ланцюг AWS.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Лише для S3-сумісних (R2/MinIO/DO). Для AWS S3 НЕ задавайте.
# S3_ENDPOINT=
# Опц. префікс key у бакеті (напр. "prod"). Дефолт — без префікса.
# S3_KEY_PREFIX=
# Час життя presigned-посилань для UI, сек. Дефолт 3600.
# S3_SIGNED_URL_TTL=3600

# --- Опціональні налаштування (мають безпечні дефолти в docker-compose) ---
# Часовий пояс (логи + UI). Дефолт Europe/Kyiv.
# TZ=Europe/Kyiv
# UI_TZ=Europe/Kyiv
# Порт publish БД на хост (dev/admin). На prod не публікуйте БД.
# PG_HOST_PORT=5434
# Розмір пулу з'єднань до БД.
# PG_POOL_MAX=10
# Ліміт розміру одного файла при завантаженні (байти). Дефолт 500 MB.
# MAX_UPLOAD_BYTES=524288000
# Скільки фонових задач можуть виконуватись одночасно.
# MAX_CONCURRENT_JOBS=3
