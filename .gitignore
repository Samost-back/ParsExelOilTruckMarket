# === Node ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === Env / secrets ===
.env
.env.*
!.env.example
*.secret
*.pem
*.key
secrets/

# === Дампи/експорти БД — містять дані й bcrypt-хеші паролів. НЕ комітити ===
db-export*.json
*-export.json
backup.sql
*.dump

# === Локальна памʼять асистента (нотатки) — не для репо ===
memory/

# === Input data (prices) — не код, можуть містити чутливі ціни/контакти ===
Excel/
*.xls
*.xlsx
*.xlsm
*.ods

# === Photo assets (large binary, regenerable) ===
photos_storage/
uploads/
PRODUCT FOTO-*.zip
*.zip
# Вхідні фото товарів (джерело обробки) — не комітимо, лише шаблони в репо.
# Винятки нижче лишають базові шаблони бочок/каністр у репо.
*.webp
*.tif
*.tiff
# "no-country" шаблони (*_nc.*) — генеровані, більше не використовуються
# (перейшли на векторні SVG-плашки). Генератор make-nc-templates.cjs лишається.
src/photos/browser-tool/templates/*_nc.*

# === Editor / IDE ===
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# === Build / temp ===
dist/
build/
.cache/
*.log
tmp/
.tmp/

# === Test coverage ===
coverage/
.nyc_output/

# === OS ===
*~
desktop.ini

# === IDE ===
# Workspace-файл містить локальні шляхи конкретної машини (напр. ../Desktop/...)
*.code-workspace
