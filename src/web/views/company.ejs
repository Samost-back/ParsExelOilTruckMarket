<div class="page-header">
  <div>
    <a href="/companies" class="btn-link breadcrumb-back">← Усі компанії</a>
    <h1><%= company.name_company %></h1>
    <p class="subtitle">
      <% if (company.country) { %><%= company.country %> · <% } %>
      Олив: <%= counts.total %>
    </p>
  </div>
  <div class="page-header-actions">
    <a href="/companies/<%= company.id %>/update-prices" class="btn-primary">🔄 Оновити ціни</a>
    <a href="#edit-company" class="btn-ghost">✎ Редагувати</a>
    <form method="post" action="/companies/<%= company.id %>/delete"
          data-confirm="Видалити «<%= company.name_company %>»?&#10;&#10;• <%= counts.done %> оголошень буде знято з TruckMarket&#10;• <%= counts.total %> олив + усі фото будуть видалені з БД&#10;&#10;Відновити неможливо.">
      <button type="submit" class="btn-danger">⊘ Видалити компанію</button>
    </form>
  </div>
</div>

<details class="card edit-company-card" id="edit-company">
  <summary>✎ Редагувати компанію</summary>
  <form method="post" action="/companies/<%= company.id %>/edit" class="form">
    <div class="form-row">
      <label class="field">
        <span class="field-label">Назва компанії <span class="req">*</span></span>
        <input type="text" name="name" required value="<%= company.name_company %>" autocomplete="off" />
      </label>
      <label class="field">
        <span class="field-label">Місто (локація оголошення)</span>
        <input type="text" name="city" value="<%= company.city || '' %>"
               placeholder="Луцьк" autocomplete="off" />
        <span class="field-hint">Стає локацією оголошення на TruckMarket</span>
      </label>
      <label class="field">
        <span class="field-label">Країна виробника</span>
        <input type="text" name="country" value="<%= company.country || '' %>"
               placeholder="Німеччина" autocomplete="off" />
        <span class="field-hint">Опціонально. Накладається на оброблене фото</span>
      </label>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn-primary">Зберегти зміни</button>
      <a href="/companies/<%= company.id %>" class="btn-ghost">Скасувати</a>
    </div>
  </form>
</details>

<section class="status-tabs">
  <a href="/companies/<%= company.id %>"               class="status-tab <%= !status ? 'active' : '' %>">
    Всі <span class="count"><%= counts.total %></span>
  </a>
  <a href="?status=pending"     class="status-tab <%= status === 'pending'     ? 'active' : '' %>">
    <span class="dot dot-pending"></span> Очікують <span class="count"><%= counts.pending %></span>
  </a>
  <a href="?status=in_progress" class="status-tab <%= status === 'in_progress' ? 'active' : '' %>">
    <span class="dot dot-warning"></span> В роботі <span class="count"><%= counts.in_progress %></span>
  </a>
  <a href="?status=done"        class="status-tab <%= status === 'done'        ? 'active' : '' %>">
    <span class="dot dot-success"></span> Опубліковано <span class="count"><%= counts.done %></span>
  </a>
  <a href="?status=failed"      class="status-tab <%= status === 'failed'      ? 'active' : '' %>">
    <span class="dot dot-danger"></span> Помилки <span class="count"><%= counts.failed %></span>
  </a>
</section>

<section class="card">
  <form method="get" action="/companies/<%= company.id %>" class="form" style="margin-bottom:1rem">
    <input type="hidden" name="status" value="<%= status %>" />
    <div class="form-row">
      <label class="field">
        <span class="field-label">Пошук</span>
        <input name="search" value="<%= search %>" placeholder="Назва або артикул…" />
      </label>
    </div>
  </form>

  <div class="table-scroll">
  <table class="jobs-table">
    <thead>
      <tr>
        <th></th>
        <th>Тип</th>
        <th>Назва</th>
        <th>Артикул</th>
        <th>Об'єм</th>
        <th>Ціна</th>
        <th>Фото</th>
        <th>TruckMarket</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% oils.forEach(o => { %>
        <tr>
          <td>
            <% if (o.img_total > 0) { %>
              <a href="/oils/<%= o.id %>/images" class="oil-thumb-link">
                <img src="/oils/<%= o.id %>/image/first" loading="lazy" alt="" class="oil-thumb-img" />
              </a>
            <% } else { %>
              <div class="oil-thumb-empty">—</div>
            <% } %>
          </td>
          <td><span class="kind-pill"><%= o.name_type_oil %></span></td>
          <td>
            <a href="/oils/<%= o.id %>/images" class="oil-name"><%= o.name %></a>
          </td>
          <td><code><%= o.articul %></code></td>
          <td><%= o.packaging_volume %> л</td>
          <td><%= o.price != null ? (o.price + " ₴") : "—" %></td>
          <td>
            <% if (o.img_total > 0) { %>
              <span class="kind-pill"><%= o.img_done %>/<%= o.img_total %></span>
            <% } else { %>
              <span class="text-muted">—</span>
            <% } %>
          </td>
          <td>
            <% if (o.truck_status === 'done') { %>
              <span class="badge badge-done">#<%= o.truck_listing_id %></span>
            <% } else if (o.truck_status === 'in_progress') { %>
              <span class="badge badge-in_progress">в роботі</span>
            <% } else if (o.truck_status === 'failed') { %>
              <span class="badge badge-failed" title="<%= o.truck_error || '' %>">помилка</span>
            <% } else { %>
              <span class="badge badge-pending">очікує</span>
            <% } %>
          </td>
          <td class="actions-cell">
            <div class="act-group">
              <a href="/oils/<%= o.id %>/images" class="act">фото</a>
              <% if (o.truck_status === 'done') { %>
                <form method="post" action="/oils/<%= o.id %>/unpublish"
                      data-confirm="Видалити #<%= o.truck_listing_id %> з TruckMarket?">
                  <button type="submit" class="act act-danger" title="Зняти з TM">⊘</button>
                </form>
              <% } else if (o.truck_status === 'outdated') { %>
                <form method="post" action="/oils/<%= o.id %>/sync-tm">
                  <button type="submit" class="act act-warning" title="Оновити на TM">⟳</button>
                </form>
              <% } else if (o.truck_status !== 'in_progress') { %>
                <form method="post" action="/oils/<%= o.id %>/publish">
                  <button type="submit" class="act act-success" title="Опублікувати">↑</button>
                </form>
              <% } %>
            </div>
          </td>
        </tr>
      <% }) %>
      <% if (oils.length === 0) { %>
        <tr><td colspan="9" class="muted">Нічого не знайдено</td></tr>
      <% } %>
    </tbody>
  </table>
  </div>
</section>
