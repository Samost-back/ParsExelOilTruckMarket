<%
  // Helper — будує query-string без пустих значень
  function qs(overrides) {
    const p = new URLSearchParams();
    const merged = { ...filters, ...overrides };
    for (const [k, v] of Object.entries(merged)) {
      if (v !== "" && v != null) p.set(k, v);
    }
    const s = p.toString();
    return s ? "?" + s : "";
  }
%>
<div class="page-header">
  <div>
    <h1>Усі оливи</h1>
    <p class="subtitle">Знайдено <%= total %></p>
  </div>
</div>

<section class="status-tabs">
  <a href="/oils<%= qs({ status: '' }) %>"
     class="status-tab <%= !filters.status ? 'active' : '' %>">
    Всі <span class="count"><%= counts.total %></span>
  </a>
  <a href="/oils<%= qs({ status: 'pending' }) %>"
     class="status-tab <%= filters.status === 'pending' ? 'active' : '' %>">
    <span class="dot dot-pending"></span> Очікують <span class="count"><%= counts.pending %></span>
  </a>
  <a href="/oils<%= qs({ status: 'in_progress' }) %>"
     class="status-tab <%= filters.status === 'in_progress' ? 'active' : '' %>">
    <span class="dot dot-warning"></span> В роботі <span class="count"><%= counts.in_progress %></span>
  </a>
  <a href="/oils<%= qs({ status: 'done' }) %>"
     class="status-tab <%= filters.status === 'done' ? 'active' : '' %>">
    <span class="dot dot-success"></span> Опубліковано <span class="count"><%= counts.done %></span>
  </a>
  <a href="/oils<%= qs({ status: 'outdated' }) %>"
     class="status-tab <%= filters.status === 'outdated' ? 'active' : '' %>">
    <span class="dot dot-warning"></span> Застарілі <span class="count"><%= counts.outdated %></span>
  </a>
  <a href="/oils<%= qs({ status: 'failed' }) %>"
     class="status-tab <%= filters.status === 'failed' ? 'active' : '' %>">
    <span class="dot dot-danger"></span> Помилки <span class="count"><%= counts.failed %></span>
  </a>
</section>

<% if (counts.outdated > 0) { %>
<section class="card toolbar-card">
  <div>
    <strong><%= counts.outdated %></strong> опублікованих олив мають змінену ціну — оголошення на TruckMarket застаріли.
  </div>
  <form method="post" action="/oils/sync-outdated"
        data-confirm="Оновити всі <%= counts.outdated %> застарілих оголошень на TruckMarket?">
    <button type="submit" class="btn-warning">⟳ Оновити всі застарілі на TM</button>
  </form>
</section>
<% } %>

<section class="card">
  <form method="get" action="/oils" class="form">
    <input type="hidden" name="status" value="<%= filters.status %>" />
    <div class="form-row">
      <label class="field">
        <span class="field-label">Пошук</span>
        <input name="search" value="<%= filters.search %>" placeholder="Назва або артикул…" />
      </label>
      <label class="field">
        <span class="field-label">Компанія</span>
        <select name="company">
          <option value="">— всі —</option>
          <% facets.companies.forEach(c => { %>
            <option value="<%= c.id %>" <%= String(filters.company) === String(c.id) ? "selected" : "" %>>
              <%= c.name_company %>
            </option>
          <% }) %>
        </select>
      </label>
      <label class="field">
        <span class="field-label">Тип</span>
        <select name="type">
          <option value="">— всі —</option>
          <% facets.types.forEach(t => { %>
            <option value="<%= t %>" <%= filters.type === t ? "selected" : "" %>><%= t %></option>
          <% }) %>
        </select>
      </label>
      <label class="field">
        <span class="field-label">Інтеграція</span>
        <select name="integration">
          <option value="">— всі —</option>
          <% facets.integrations.forEach(ig => { %>
            <option value="<%= ig.id %>" <%= String(filters.integration) === String(ig.id) ? "selected" : "" %>>
              <%= ig.name %>
            </option>
          <% }) %>
        </select>
      </label>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn-primary">Фільтрувати</button>
      <a href="/oils" class="btn-link">Очистити</a>
    </div>
  </form>
</section>

<section class="card">
  <div class="table-scroll">
  <table class="jobs-table oils-table">
    <thead>
      <tr>
        <th class="col-thumb"></th>
        <th>Тип</th>
        <th class="col-company">Компанія</th>
        <th>Назва</th>
        <th>Бренд</th>
        <th class="col-city">Місто</th>
        <th class="col-integration">Інтеграція</th>
        <th class="col-articul">Артикул</th>
        <th class="col-volume">Об'єм</th>
        <th>Ціна</th>
        <th class="col-photo">Фото</th>
        <th>TM</th>
        <th class="col-actions"></th>
      </tr>
    </thead>
    <tbody>
      <% oils.forEach(o => { %>
        <%- include("_oil-row", { o }) %>
      <% }) %>
      <% if (oils.length === 0) { %>
        <tr><td colspan="13" class="muted">Нічого не знайдено</td></tr>
      <% } %>
    </tbody>
  </table>
  </div>

  <% if (total > perPage) { %>
    <div class="pagination">
      <% const totalPages = Math.ceil(total / perPage); %>
      <% if (page > 1) { %>
        <a href="/oils<%= qs({ page: page - 1 }) %>" class="btn-link">← попередня</a>
      <% } %>
      <span class="text-muted">Сторінка <%= page %> / <%= totalPages %></span>
      <% if (page < totalPages) { %>
        <a href="/oils<%= qs({ page: page + 1 }) %>" class="btn-link">наступна →</a>
      <% } %>
    </div>
  <% } %>
</section>
