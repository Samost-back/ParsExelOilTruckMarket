<div class="page-header">
  <div>
    <h1>Дашборд</h1>
    <p class="subtitle">Огляд стану піпелайну</p>
  </div>
</div>

<section class="cards">
  <div class="card stat">
    <div class="stat-label">Олив у БД</div>
    <div class="stat-value"><%= stats.oils %></div>
  </div>
  <div class="card stat">
    <div class="stat-label">Фото (зв'язків)</div>
    <div class="stat-value"><%= stats.photos %></div>
  </div>
  <div class="card stat">
    <div class="stat-label">Оброблено</div>
    <div class="stat-value"><%= stats.processed %></div>
  </div>
  <div class="card stat">
    <div class="stat-label">На TruckMarket</div>
    <div class="stat-value"><%= stats.published %></div>
  </div>
</section>

<section class="card">
  <div class="card-header">
    <h2>Останні задачі</h2>
    <a href="/jobs" class="btn-link">Усі →</a>
  </div>
  <table class="jobs-table">
    <thead>
      <tr><th>ID</th><th>Тип</th><th>Статус</th><th>Створено</th><th></th></tr>
    </thead>
    <tbody>
      <% jobs.forEach(j => { %>
        <tr>
          <td><span class="job-id">#<%= j.id %></span></td>
          <td><span class="kind-pill"><%= j.kind %></span></td>
          <td><span class="badge badge-<%= j.status %>"><%= j.status %></span></td>
          <td class="text-muted"><%= j.created_at && new Date(j.created_at).toLocaleString("uk-UA") %></td>
          <td><a href="/jobs/<%= j.id %>">логи →</a></td>
        </tr>
      <% }) %>
      <% if (jobs.length === 0) { %>
        <tr><td colspan="5" class="muted">Поки немає задач</td></tr>
      <% } %>
    </tbody>
  </table>
</section>
