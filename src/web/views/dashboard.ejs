<h1>Pipeline Dashboard</h1>

<section class="cards">
  <div class="card stat">
    <div class="stat-label">Олив у БД</div>
    <div class="stat-value"><%= stats.oils %></div>
  </div>
  <div class="card stat">
    <div class="stat-label">Фото (зв'язків)</div>
    <div class="stat-value"><%= stats.photos %></div>
  </div>
  <div class="card stat">
    <div class="stat-label">Оброблено (processed)</div>
    <div class="stat-value"><%= stats.processed %></div>
  </div>
  <div class="card stat">
    <div class="stat-label">На TruckMarket</div>
    <div class="stat-value"><%= stats.published %></div>
  </div>
</section>

<section class="card">
  <h2>1. Парсинг прайсу + імпорт фото</h2>
  <form method="post" action="/upload" enctype="multipart/form-data">
    <label>
      <span>Назва компанії</span>
      <input name="company" required placeholder="EUROLUB" />
    </label>
    <label>
      <span>Країна (для прапора)</span>
      <input name="country" placeholder="Німеччина" />
    </label>
    <label>
      <span>Excel прайс (.xlsx)</span>
      <input type="file" name="xlsx" accept=".xlsx" required />
    </label>
    <label>
      <span>Архів фото (.zip) — опціонально</span>
      <input type="file" name="photos" accept=".zip" />
    </label>
    <button type="submit" class="btn-primary">Завантажити і обробити</button>
  </form>
</section>

<section class="card">
  <h2>2. Обробити фото (sharp + прапор)</h2>
  <form method="post" action="/photos/process">
    <label>
      <span>Limit (порожньо = всі pending)</span>
      <input name="limit" type="number" min="1" />
    </label>
    <button type="submit" class="btn-primary">Обробити</button>
  </form>
</section>

<section class="card">
  <h2>3. Інтеграція TruckMarket</h2>
  <form method="post" action="/integrations/truckmarket/run">
    <label>
      <span>Limit (порожньо = 10)</span>
      <input name="limit" type="number" min="1" />
    </label>
    <label class="checkbox">
      <input type="checkbox" name="noAi" />
      <span>Без OpenAI-описів</span>
    </label>
    <button type="submit" class="btn-primary">Запустити</button>
  </form>
</section>

<section class="card">
  <h2>Останні задачі</h2>
  <table class="jobs-table">
    <thead>
      <tr><th>ID</th><th>Тип</th><th>Статус</th><th>Створено</th><th></th></tr>
    </thead>
    <tbody>
      <% jobs.forEach(j => { %>
        <tr>
          <td>#<%= j.id %></td>
          <td><%= j.kind %></td>
          <td><span class="badge badge-<%= j.status %>"><%= j.status %></span></td>
          <td><%= j.created_at && new Date(j.created_at).toLocaleString("uk-UA") %></td>
          <td><a href="/jobs/<%= j.id %>">логи →</a></td>
        </tr>
      <% }) %>
      <% if (jobs.length === 0) { %>
        <tr><td colspan="5" class="muted">Поки немає</td></tr>
      <% } %>
    </tbody>
  </table>
</section>
