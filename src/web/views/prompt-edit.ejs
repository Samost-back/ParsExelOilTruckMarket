<div class="page-header">
  <div>
    <a href="/prompts" class="btn-link breadcrumb-back">← Усі промпти</a>
    <h1><%= mode === "create" ? "Новий промпт" : prompt.name %></h1>
    <p class="subtitle">System-prompt що подається в OpenAI при кожному виклику</p>
  </div>
</div>

<section class="card">
  <form method="post" action="<%= mode === 'create' ? '/prompts' : ('/prompts/' + prompt.id) %>" class="form">
    <label class="field">
      <span class="field-label">Назва <span class="req">*</span></span>
      <input name="name" required value="<%= prompt.name %>" placeholder="TruckMarket SEO" />
      <span class="field-hint">Для внутрішнього використання, не показується в OpenAI</span>
    </label>

    <label class="field">
      <span class="field-label">Текст промпту <span class="req">*</span></span>
      <textarea name="body" id="promptBody" required rows="20"><%= prompt.body %></textarea>
      <span class="field-hint">Передається як <code>role: "system"</code> при кожній генерації опису</span>
    </label>

    <% if (mode === "create") { %>
      <label class="checkbox">
        <input type="checkbox" name="makeDefault" />
        <span>Зробити дефолтним (використовуватись при публікації)</span>
      </label>
    <% } %>

    <div class="form-actions">
      <button type="submit" class="btn-primary">
        <%= mode === "create" ? "Створити" : "Зберегти" %>
      </button>
      <a href="/prompts" class="btn-link">Скасувати</a>
    </div>
  </form>
</section>

<section class="card">
  <div class="card-header">
    <h2>🧪 Симулятор опису</h2>
  </div>
  <p class="field-hint sim-hint">
    Виберіть оливу і згенеруйте приблизний опис за <strong>поточним текстом промпту вище</strong>
    (навіть незбережені зміни враховуються). Результат у БД не зберігається.
  </p>
  <div class="sim-controls">
    <label class="field sim-select">
      <span class="field-label">Олива</span>
      <select id="simOil" name="oils_id">
        <option value="">— виберіть оливу —</option>
        <% (oils || []).forEach(o => { %>
          <option value="<%= o.id %>"><%= o.name %> · <%= o.articul %> (<%= o.name_company %>)</option>
        <% }) %>
      </select>
    </label>
    <button type="button" class="btn-primary"
            hx-post="/prompts/simulate"
            hx-include="#promptBody, #simOil"
            hx-target="#simResult" hx-swap="innerHTML"
            hx-indicator="#simSpin">
      ▶ Симулювати
    </button>
    <span id="simSpin" class="htmx-indicator text-muted">генерація…</span>
  </div>
  <div id="simResult"></div>
</section>
