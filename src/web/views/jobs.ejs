<div class="page-header">
  <div>
    <h1>Задачі</h1>
    <p class="subtitle">Історія всіх фонових задач</p>
  </div>
</div>

<section class="card">
  <table class="jobs-table">
    <thead>
      <tr><th>ID</th><th>Тип</th><th>Статус</th><th>Створено</th><th>Завершено</th><th></th></tr>
    </thead>
    <tbody>
      <% jobs.forEach(j => { %>
        <tr>
          <td><span class="job-id">#<%= j.id %></span></td>
          <td><span class="kind-pill"><%= j.kind %></span></td>
          <td><span class="badge badge-<%= j.status %>"><%= j.status %></span></td>
          <td class="text-muted"><%= j.created_at && new Date(j.created_at).toLocaleString("uk-UA") %></td>
          <td class="text-muted"><%= j.finished_at ? new Date(j.finished_at).toLocaleString("uk-UA") : "—" %></td>
          <td><a href="/jobs/<%= j.id %>">логи →</a></td>
        </tr>
      <% }) %>
      <% if (jobs.length === 0) { %>
        <tr><td colspan="6" class="muted">Поки немає задач</td></tr>
      <% } %>
    </tbody>
  </table>
</section>
