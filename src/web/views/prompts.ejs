<div class="page-header">
  <div>
    <h1>AI промпти</h1>
    <p class="subtitle">System-промпт для генерації SEO-описів при публікації</p>
  </div>
</div>

<section class="card">
  <table class="jobs-table">
    <thead>
      <tr>
        <th>Назва</th>
        <th>Дефолтний</th>
        <th>Оновлено</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% prompts.forEach(p => { %>
        <tr>
          <td><strong><%= p.name %></strong></td>
          <td>
            <% if (p.is_default) { %>
              <span class="badge badge-done">дефолт</span>
            <% } else { %>
              <form method="post" action="/prompts/<%= p.id %>/default" style="display:inline">
                <button type="submit" class="btn-link">Зробити дефолтом</button>
              </form>
            <% } %>
          </td>
          <td class="text-muted" style="font-size:0.78rem">
            <%= new Date(p.updated_at).toLocaleString("uk-UA") %>
          </td>
          <td>
            <a href="/prompts/<%= p.id %>/edit">редагувати →</a>
            <% if (!p.is_default) { %>
              <form method="post" action="/prompts/<%= p.id %>/delete" style="display:inline; margin-left:0.5rem"
                    onsubmit="return confirm('Видалити промпт «<%= p.name %>»?')">
                <button type="submit" class="btn-link" style="color:var(--danger)">видалити</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (prompts.length === 0) { %>
        <tr><td colspan="4" class="muted">Поки немає промптів</td></tr>
      <% } %>
    </tbody>
  </table>
</section>
