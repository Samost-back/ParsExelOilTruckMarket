<div class="page-header">
  <div>
    <h1>Імпорт / оновлення даних</h1>
    <p class="subtitle">Розумне оновлення: програма сама бачить, що змінилось</p>
  </div>
</div>

<section class="card info-card">
  <h2>Як це працює</h2>
  <ul class="info-list">
    <li><strong>Прайс (xlsx):</strong> для кожного товару дивимось за <em>артикулом</em> — нового додаємо, наявному оновлюємо характеристики, ціну ведемо історією. Якщо ціна змінилась, а товар уже на TruckMarket — позначаємо «треба оновити».</li>
    <li><strong>Папка з фото:</strong> матчимо фото до наявних олив (за артикулом/об'ємом) і обробляємо <em>лише нові</em> — накладаємо на шаблон бочки/каністри.</li>
    <li><strong>Можна окремо:</strong> або тільки прайс, або тільки фото (донести фото до вже завантажених олив). Хоча б одне з двох.</li>
    <li><strong>Контроль:</strong> після старту відкриється сторінка задачі з покроковими статусами, живим логом і карткою-зведенням (скільки створено / оновлено / змінено цін / додано фото).</li>
  </ul>
</section>

<section class="card">
  <form method="post" action="/import" enctype="multipart/form-data" class="form">
    <%
      // Режим керує лише ТИМ, ЯК задається компанія (нова текстом vs наявна
      // зі списку). Логіка збереження однакова (upsert) — нові артикули
      // додаються, наявні оновлюються. У "Оновити" компанія мусить існувати.
      const hasCompanies = companies && companies.length;
    %>
    <input type="hidden" name="mode" id="modeInput" value="add" />
    <div class="mode-switch" role="tablist" aria-label="Режим імпорту">
      <button type="button" class="mode-btn is-active" data-mode="add" role="tab">
        Додати нову компанію
      </button>
      <button type="button" class="mode-btn" data-mode="update" role="tab"
              <%= hasCompanies ? "" : "disabled title='Немає компаній для оновлення'" %>>
        Оновити наявну
      </button>
    </div>

    <div class="form-row">
      <!-- Інтеграція — лише при ДОДАВАННІ. У "Оновити" береться з самої компанії. -->
      <label class="field" data-mode-block="add">
        <span class="field-label">Інтеграція <span class="req">*</span></span>
        <select name="integration" id="integrationSelect" required>
          <% integrations.forEach(i => { %>
            <option value="<%= i.code %>" <%= i.code === "EUROLUB" ? "selected" : "" %>><%= i.name %></option>
          <% }) %>
        </select>
        <span class="field-hint">Стандарт прайсу. Визначає, звідки бренд і місто</span>
      </label>

      <!-- Режим ДОДАТИ: нова компанія текстом -->
      <label class="field" data-field="company" data-mode-block="add">
        <span class="field-label">Назва нової компанії <span class="req">*</span></span>
        <input name="companyNew" id="companyInput" placeholder="EUROLUB" autocomplete="off" />
        <span class="field-hint">Створиться нова компанія з цією назвою</span>
      </label>

      <!-- Режим ОНОВИТИ: лише вибір наявної компанії зі списку -->
      <label class="field" data-field="company" data-mode-block="update" hidden>
        <span class="field-label">Компанія для оновлення <span class="req">*</span></span>
        <select name="companyExisting" id="companySelect" disabled>
          <option value="" disabled selected>— виберіть компанію —</option>
          <% (companies || []).forEach(c => { %>
            <option value="<%= c.name_company %>"><%= c.name_company %></option>
          <% }) %>
        </select>
        <span class="field-hint">Доносимо прайс/фото до наявних олив цієї компанії</span>
      </label>

      <!-- Місто/Країна — лише при ДОДАВАННІ (атрибути нової компанії). -->
      <label class="field" data-field="city" data-mode-block="add">
        <span class="field-label">Місто (локація оголошення)</span>
        <input name="city" placeholder="Луцьк" autocomplete="off" />
        <span class="field-hint">Місто компанії — стає локацією оголошення на TruckMarket</span>
      </label>

      <label class="field" data-field="country" data-mode-block="add">
        <span class="field-label">Країна виробника</span>
        <input name="country" placeholder="Німеччина" autocomplete="off" />
        <span class="field-hint">Опціонально. Накладається на оброблене фото</span>
      </label>
    </div>

    <label class="field">
      <span class="field-label">Excel прайс</span>
      <div class="file-drop file-drop--file" data-target="xlsx">
        <input type="file" name="xlsx" id="xlsxInput" accept=".xlsx,.xls,.xlsm,.csv,.ods" />
        <div class="file-drop-text" data-default>
          <strong>Натисніть або перетягніть файл сюди</strong>
          <span class="field-hint">Необов'язково, якщо доносите лише фото. Підтримуються .xlsx, .xls, .xlsm, .csv, .ods. Колонки: Найменування, Артикул, Упаковка, Ціна</span>
        </div>
        <div class="file-drop-selected" data-selected hidden>
          <div class="file-pill"><span class="file-icon">📄</span> <span data-name></span></div>
          <button type="button" class="btn-clear" data-clear>Очистити</button>
        </div>
      </div>
    </label>

    <label class="field">
      <span class="field-label">Папка з фото</span>
      <div class="file-drop" data-target="photos">
        <input type="file" name="photos" id="photosInput" webkitdirectory directory multiple />
        <div class="file-drop-text" data-default>
          <strong>Виберіть папку з фото</strong>
          <span class="field-hint">Опціонально. Підкаталоги обробляються рекурсивно. Ім'я файлу = articul</span>
        </div>
        <div class="file-drop-selected" data-selected hidden>
          <div class="file-pill"><span class="file-icon">📁</span> <span data-name></span></div>
          <div class="file-summary" data-summary></div>
          <button type="button" class="btn-clear" data-clear>Очистити</button>
        </div>
      </div>
    </label>

    <div class="form-actions">
      <button type="submit" class="btn-primary" id="submitBtn">Завантажити і обробити</button>
    </div>

    <div id="uploadProgress" class="upload-progress" hidden>
      <div class="upload-progress-row">
        <span class="upload-progress-label" id="uploadLabel">Завантаження…</span>
        <span class="upload-progress-pct" id="uploadPct">0%</span>
      </div>
      <div class="upload-progress-bar"><div id="uploadBar" class="upload-progress-fill"></div></div>
      <div class="upload-progress-row">
        <span class="upload-progress-detail" id="uploadDetail">—</span>
      </div>
    </div>
  </form>
</section>

<script>

  (function () {
    function fmtBytes(n) {
      if (n < 1024) return n + " B";
      if (n < 1024 * 1024) return (n / 1024).toFixed(1) + " KB";
      if (n < 1024 * 1024 * 1024) return (n / 1024 / 1024).toFixed(1) + " MB";
      return (n / 1024 / 1024 / 1024).toFixed(2) + " GB";
    }

    // --- File drop indicators ---
    document.querySelectorAll(".file-drop").forEach(function (drop) {
      var input    = drop.querySelector("input[type=file]");
      var dflt     = drop.querySelector("[data-default]");
      var sel      = drop.querySelector("[data-selected]");
      var nameEl   = sel.querySelector("[data-name]");
      var sumEl    = sel.querySelector("[data-summary]");
      var clearBtn = sel.querySelector("[data-clear]");

      function render() {
        var files = input.files;
        if (!files || files.length === 0) {
          dflt.hidden = false;
          sel.hidden = true;
          drop.classList.remove("has-file");
          return;
        }
        dflt.hidden = true;
        sel.hidden = false;
        drop.classList.add("has-file");

        if (files.length === 1) {
          var f = files[0];
          var rel = f.webkitRelativePath || "";
          nameEl.textContent = rel || f.name;
          if (sumEl) sumEl.textContent = fmtBytes(f.size);
        } else {
          var first = files[0];
          var rel = first.webkitRelativePath || "";
          var root = rel.split("/")[0] || "(папка)";
          nameEl.textContent = root + " / ";
          if (sumEl) {
            var total = 0;
            for (var i = 0; i < files.length; i++) total += files[i].size;
            sumEl.textContent = files.length + " файлів · " + fmtBytes(total);
          }
        }
      }

      input.addEventListener("change", render);
      if (clearBtn) clearBtn.addEventListener("click", function (e) {
        e.stopPropagation();
        e.preventDefault();
        input.value = "";
        render();
      });
      render();
    });

    // --- Перемикач режиму "Додати нову" / "Оновити наявну" ---
    // Керує лише тим, як задається компанія. Активний блок отримує валідне
    // поле компанії; неактивний — disabled (не сабмітиться).
    var modeInput   = document.getElementById("modeInput");
    var companyText = document.getElementById("companyInput");   // companyNew
    var companySel  = document.getElementById("companySelect");  // companyExisting
    var modeBtns    = document.querySelectorAll(".mode-btn");
    var blocksAdd   = document.querySelectorAll('[data-mode-block="add"]');
    var blocksUpd   = document.querySelectorAll('[data-mode-block="update"]');

    function applyMode(mode) {
      var isUpdate = mode === "update";
      modeInput.value = isUpdate ? "update" : "add";
      // add-блоки (інтеграція, нова назва, місто, країна) — приховані в "Оновити".
      // Їхні контроли робимо disabled, щоб вони не сабмітились і не блокували
      // валідацію через required, поки приховані.
      blocksAdd.forEach(function (b) {
        b.hidden = isUpdate;
        b.querySelectorAll("input, select, textarea").forEach(function (el) {
          el.disabled = isUpdate;
        });
      });
      blocksUpd.forEach(function (b) {
        b.hidden = !isUpdate;
        b.querySelectorAll("input, select, textarea").forEach(function (el) {
          el.disabled = !isUpdate;
        });
      });
      // required лише на активному полі компанії.
      if (companyText) companyText.required = !isUpdate;
      if (companySel)  companySel.required  = isUpdate;
      modeBtns.forEach(function (btn) {
        btn.classList.toggle("is-active", btn.dataset.mode === mode);
      });
    }
    modeBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        if (btn.disabled) return;
        applyMode(btn.dataset.mode);
      });
    });
    applyMode("add"); // дефолт

    // --- Upload progress (XHR замість form submit) ---
    var form = document.querySelector("form[action='/import']");
    if (!form) return;
    var progressBox    = document.getElementById("uploadProgress");
    var progressBar    = document.getElementById("uploadBar");
    var progressPct    = document.getElementById("uploadPct");
    var progressLabel  = document.getElementById("uploadLabel");
    var progressDetail = document.getElementById("uploadDetail");
    var submitBtn      = document.getElementById("submitBtn");

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var isUpdate = modeInput.value === "update";
      // Компанія: у "Додати" — текст, у "Оновити" — вибір зі списку.
      var companyVal = isUpdate
        ? (companySel && companySel.value || "")
        : (companyText && companyText.value || "").trim();
      if (!companyVal) {
        alert(isUpdate ? "Виберіть компанію зі списку." : "Введіть назву нової компанії.");
        return;
      }
      // Хоча б одне з двох: прайс або папка фото.
      var xlsxInput = document.getElementById("xlsxInput");
      var photosInput = document.getElementById("photosInput");
      var hasXlsx = xlsxInput && xlsxInput.files && xlsxInput.files.length > 0;
      var hasPhotos = photosInput && photosInput.files && photosInput.files.length > 0;
      if (!hasXlsx && !hasPhotos) {
        alert("Додайте Excel прайс або папку з фото (хоча б одне).");
        return;
      }
      var fd = new FormData(form);
      var xhr = new XMLHttpRequest();
      xhr.open("POST", form.action, true);

      progressBox.hidden = false;
      progressLabel.textContent = "Завантаження файлів…";
      submitBtn.disabled = true;
      submitBtn.textContent = "Завантаження…";

      var startTs = Date.now();
      xhr.upload.onprogress = function (evt) {
        if (!evt.lengthComputable) return;
        var pct = Math.round((evt.loaded / evt.total) * 100);
        progressBar.style.width = pct + "%";
        progressPct.textContent = pct + "%";
        var elapsed = (Date.now() - startTs) / 1000;
        var speed = elapsed > 0 ? evt.loaded / elapsed : 0;
        progressDetail.textContent =
          fmtBytes(evt.loaded) + " / " + fmtBytes(evt.total) +
          " · " + fmtBytes(speed) + "/s";
      };

      xhr.upload.onload = function () {
        progressLabel.textContent = "Файли отримано, очікую відповідь сервера…";
        progressDetail.textContent = "Сервер створює задачу…";
      };

      xhr.onload = function () {
        if (xhr.status >= 200 && xhr.status < 400) {
          var loc = xhr.getResponseHeader("Location") || xhr.responseURL;
          if (loc) window.location.href = loc;
          else window.location.reload();
        } else {
          progressLabel.textContent = "Помилка " + xhr.status;
          progressDetail.textContent = xhr.responseText || "—";
          submitBtn.disabled = false;
          submitBtn.textContent = "Завантажити і обробити";
        }
      };

      xhr.onerror = function () {
        progressLabel.textContent = "Помилка з'єднання";
        submitBtn.disabled = false;
        submitBtn.textContent = "Завантажити і обробити";
      };

      xhr.send(fd);
    });
  })();
</script>

<% if (companies && companies.length) { %>
<section class="card">
  <h2>Останні завантаження по компаніях</h2>
  <table class="jobs-table">
    <thead>
      <tr>
        <th>Компанія</th>
        <th>Країна</th>
        <th>Excel</th>
        <th>Фото</th>
      </tr>
    </thead>
    <tbody>
      <% companies.forEach(c => { %>
        <tr>
          <td><strong><%= c.name_company %></strong></td>
          <td><%= c.country || "—" %></td>
          <td>
            <% if (c.xlsx_path) { %>
              <code><%= c.xlsx_path %></code>
              <div class="text-muted" style="font-size:0.78rem">
                <%= fmtDate(c.xlsx_at) %>
              </div>
            <% } else { %>
              <span class="text-muted">—</span>
            <% } %>
          </td>
          <td>
            <% if (c.photos_dir) { %>
              <code><%= c.photos_dir %></code>
              <div class="text-muted" style="font-size:0.78rem">
                <%= fmtDate(c.photos_at) %>
              </div>
            <% } else { %>
              <span class="text-muted">—</span>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<% } %>
